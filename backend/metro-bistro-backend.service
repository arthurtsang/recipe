[Unit]
Description=Metro Bistro Backend Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=tsangc1
Group=tsangc1
WorkingDirectory=/home/tsangc1/Projects/recipe/backend
EnvironmentFile=-/home/tsangc1/Projects/recipe/backend/.env
Environment=PATH=/home/tsangc1/Projects/recipe/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=PORT=8081
ExecStartPre=/usr/bin/npm install
ExecStartPre=/usr/bin/npx prisma generate
ExecStartPre=/usr/bin/npx prisma migrate deploy
ExecStartPre=/usr/bin/npm run build:backend
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

Environment=WASABI_CONFIG_PATH=/home/tsangc1/Projects/recipe/.wasabi.yaml
Environment=AI_SERVICE_URL=http://127.0.0.1:8001
# Environment=JWT_SECRET=your_jwt_secret_here

[Install]
WantedBy=multi-user.target
