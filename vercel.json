{
  "buildCommand": "pushd backend && npm ci --omit=dev && npm run build && popd && cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/dist/index.js" },
    { "source": "/auth/:path*", "destination": "/backend/dist/index.js" },
    { "source": "/uploads/:path*", "destination": "/backend/dist/index.js" }
  ]
}
