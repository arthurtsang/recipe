{
  "buildCommand": "bash backend/scripts/install-pg-dump-for-vercel.sh && npm ci --omit=dev --prefix backend && npm run migrate:deploy --prefix backend && npm run build:backend --prefix backend && npm ci --include=dev --prefix web && npm run build --prefix web",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/uploads/:path*", "destination": "/api" },
    { "source": "/logout", "destination": "/api" },
    { "source": "/((?!api/|auth/|uploads/|assets/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": ["backend/dist/**", "backend/bin/**"]
    }
  },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 6 * * *" },
    { "path": "/api/cron/backup", "schedule": "0 2 * * *" }
  ]
}
