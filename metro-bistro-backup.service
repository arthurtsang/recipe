[Unit]
Description=Metro Bistro Backup Service
After=network.target metro-bistro-postgres.service metro-bistro-backend.service
Wants=metro-bistro-postgres.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/tsangc1/Projects/recipe
ExecStart=/home/tsangc1/Projects/recipe/backup-metro-bistro.sh
