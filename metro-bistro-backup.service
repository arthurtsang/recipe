[Unit]
Description=Metro Bistro Database Backup (Wasabi)
After=network.target metro-bistro-backend.service

[Service]
Type=oneshot
User=tsangc1
Group=tsangc1
WorkingDirectory=/home/tsangc1/Projects/recipe/backend
EnvironmentFile=-/home/tsangc1/Projects/recipe/backend/.env
Environment=WASABI_CONFIG_PATH=/home/tsangc1/Projects/recipe/.wasabi.yaml
Environment=PATH=/home/tsangc1/Projects/recipe/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/npx tsx scripts/backup-db-to-wasabi.ts
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
